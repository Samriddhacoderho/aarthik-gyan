#Put your neo4j graph database url
NEO4J_URI="neo4j+s://xxxxxxxxx.databases.neo4j.io"

#Put your neo4j graph database username
NEO4J_USERNAME=xxxxxxx

#Put your neo4j graph database password
NEO4J_PASSWORD=xxxxxxxxxxxx

# Pick whichever LLM provider you're using
GOOGLE_API_KEY=xxxxxxxxx

#Vector Database
QDRANT_API_KEY=xxxxxxxxxxxx
QDRANT_URL=https://xxxxxxxxxxxx.qdrant.io

#Embedding Model API
HUGGINGFACEHUB_API_TOKEN=hf_xxxxxx